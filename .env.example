# Copy to .env. Development endpoints bind to loopback by default.
MPR_HOST=127.0.0.1
MPR_PORT=8080
MPR_DATA_DIR=./data
# Required when listening beyond localhost. Never commit real credentials.
MPR_API_KEY=
MPR_PUBLIC_BASE_URL=http://localhost:8080
MPR_MAX_UPLOAD_MB=25

# MinerU 4.1.7. http = standalone file-parse-server on port 8003;
# cli = mineru-kit installed in a separate inference environment.
MPR_MINERU_MODE=http
MPR_MINERU_BASE_URL=http://localhost:8003
MPR_MINERU_API_KEY=
MPR_MINERU_COMMAND=mineru-kit
MPR_MINERU_TIER=standard
MPR_PARSE_TIMEOUT_SECONDS=900

# minio | local. Only extracted images are public; PDFs and raw output stay private.
MPR_STORAGE_BACKEND=minio
MPR_MINIO_ENDPOINT=localhost:19000
MPR_MINIO_ACCESS_KEY=local-development
MPR_MINIO_SECRET_KEY=local-development-change-this
MPR_MINIO_SECURE=false
MPR_MINIO_BUCKET=multiparserag-images
# Browser-facing URL, INCLUDING bucket. Use an externally reachable HTTPS hostname on a server.
MPR_MINIO_PUBLIC_BASE_URL=http://localhost:19000/multiparserag-images

# RAGFlow v0.27.2 HTTP contract. Deploy using its official compose, configure embedding
# and create a General knowledge base in the upstream UI before enabling these values.
MPR_RAGFLOW_BASE_URL=http://localhost:9380
MPR_RAGFLOW_API_KEY=
# Comma-separated dataset IDs. Requests can only address these datasets.
MPR_RAGFLOW_DATASET_IDS=
