            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "similarity_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Similarity Threshold",
            "default": 0.2
          },
          "max_context_chars": {
            "type": "integer",
